{
  "components": {
    "schemas": {
      "DependencyChecks": {
        "properties": {
          "database": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database",
            "type": "string"
          },
          "migrations": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Migrations",
            "type": "string"
          },
          "redis": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Redis",
            "type": "string"
          }
        },
        "required": [
          "database",
          "migrations",
          "redis"
        ],
        "title": "DependencyChecks",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "Readiness": {
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/DependencyChecks"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "Readiness",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "ActionDesk API",
    "version": "0.0.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "Operations"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "get_readiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Dependencies or migrations unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "Operations"
        ]
      }
    }
  }
}
